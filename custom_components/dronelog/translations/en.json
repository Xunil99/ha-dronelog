{
  "config": {
    "step": {
      "user": {
        "title": "Set up DroneLog",
        "description": "Enter this pairing code in the DroneLog app:\n\n`{token}`\n\nYou can view or renew it later in the integration options."
      }
    },
    "abort": {
      "single_instance_allowed": "DroneLog is already set up."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Pairing code",
        "description": "Current pairing code:\n\n`{token}`",
        "data": {
          "regenerate": "Generate a new pairing code (the app must be paired again afterwards)",
          "api_key": "DJI API key (leave empty to keep, currently: {key_state})",
          "weather_enabled": "Fetch weather and wind from Open-Meteo",
          "tile_url": "Map tile URL (with {z}, {x}, {y}); the tile provider can see the viewed area"
        }
      }
    },
    "error": {
      "invalid_tile_url": "The URL must start with http(s):// and contain {z}, {x} and {y}."
    }
  },
  "services": {
    "reprocess": {
      "name": "Re-process flights",
      "description": "Re-processes failed and waiting files (or one specific file).",
      "fields": {
        "sha256": {
          "name": "SHA-256 of the file",
          "description": "SHA-256 of the file"
        }
      }
    },
    "delete_flight": {
      "name": "Delete flight",
      "description": "Removes a flight from the database. The original file is kept.",
      "fields": {
        "flight_id": {
          "name": "Flight ID",
          "description": "Flight ID"
        }
      }
    }
  },
  "entity": {
    "sensor": {
      "flights_total": {
        "name": "Flights total"
      },
      "flight_time_total": {
        "name": "Flight time total"
      },
      "distance_total": {
        "name": "Distance total"
      },
      "last_flight": {
        "name": "Last flight"
      },
      "last_flight_duration": {
        "name": "Last flight duration"
      },
      "last_flight_distance": {
        "name": "Last flight distance"
      },
      "last_flight_max_height": {
        "name": "Last flight max height"
      },
      "files_pending": {
        "name": "Files in queue"
      },
      "files_error": {
        "name": "Files with error"
      },
      "charge_end_last_flight": {
        "name": "Charge after last flight"
      },
      "health": {
        "name": "Health"
      },
      "cycles": {
        "name": "Charge cycles"
      },
      "cell_deviation_last_flight": {
        "name": "Cell deviation last flight"
      },
      "temperature_max_last_flight": {
        "name": "Max temperature last flight"
      },
      "battery_flights": {
        "name": "Flights"
      },
      "drone_flights": {
        "name": "Flights"
      },
      "drone_flight_time": {
        "name": "Flight time"
      },
      "hours_since_service": {
        "name": "Flight hours since service"
      }
    },
    "event": {
      "new_flight": {
        "name": "New flight"
      }
    },
    "binary_sensor": {
      "maintenance_due": {
        "name": "Maintenance due"
      }
    }
  }
}
